{
  "csharp-ls": {
    "command": "dnx",
    "args": [
      "roslyn-language-server",
      "--yes",
      "--prerelease",
      "--",
      "--stdio",
      "--daemon-mode",
      "--autoLoadProjects"
    ],
    "extensionToLanguage": {
      ".cs": "csharp"
    },
    "startupTimeout": 120000
  }
}
